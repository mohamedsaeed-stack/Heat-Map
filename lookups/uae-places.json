{
  "_comment": "UAE place gazetteer for allocating CRM/admin records to an emirate and, where possible, to an area inside it. Built 19 Sep 2026. Scope was set by the user: emirate names, city names and UAE names only - no other signal is treated as a location.",
  "_matching_rules": {
    "normalise": "lowercase, strip punctuation and accents, collapse whitespace, then substring match",
    "precedence": [
      "1. company.city            - the record's own city field",
      "2. company.state           - the record's own state/region field",
      "3. company.country         - only proves UAE, never an emirate",
      "4. company.address         - free text, may name an area",
      "5. company.name            - weakest; IGNORED when company.country is set and is NOT the UAE, because 'X Dubai Ltd' registered in India is an Indian company",
      "6. contact.city            - only when the company itself carries nothing"
    ],
    "ambiguity": "A token that matches two emirates is refused and the record stays UAE-level only.",
    "false_positive_guard": "Short tokens (rak, auh, dxb, uae) are matched ONLY on country/state fields, never inside a free-text name or address, because they occur inside unrelated words."
  },
  "uae_tokens": [
    "united arab emirates",
    "u.a.e",
    "uae",
    "emirates",
    "are"
  ],
